        "@angular/platform-browser": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@ngrx/effects": "^21.1.0",
        "@ngrx/entity": "^21.1.0",
        "@ngrx/operators": "^21.0.0",
        "@ngrx/router-store": "^21.0.1",
        "@ngrx/store": "^21.1.0",
        "@ngrx/store-devtools": "^21.0.0",
        "bootstrap": "^5.3.8",
