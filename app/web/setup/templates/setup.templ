package templates

type SetupViewData struct {
	Email     string
	FirstName string
	LastName  string
	Errors    map[string]string
}

templ SetupView(data SetupViewData) {
	<html xmlns="http://www.w3.org/1999/xhtml">
		<head>
			<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
			<meta name="viewport" content="initial-scale=1.0, width=device-width"/>
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>

			<style>
				:root {
					font-family: Inter, system-ui, sans-serif;
				}

				* {
					box-sizing: border-box;
				}

				body {
					margin: 0;
					min-height: 100vh;
					background: #f4f4f5;
					color: #18181b;
				}

				.page {
					min-height: 100vh;
					display: flex;
					align-items: center;
					justify-content: center;
					padding: 24px;
				}

				.card {
					width: 100%;
					max-width: 480px;
					background: white;
					border-radius: 24px;
					padding: 32px;
					box-shadow:
						0 10px 15px -3px rgb(0 0 0 / 0.1),
						0 4px 6px -4px rgb(0 0 0 / 0.1);
					border: 1px solid #e4e4e7;
				}

				.title {
					font-size: 28px;
					font-weight: 600;
					letter-spacing: -0.025em;
					margin: 0;
				}

				.subtitle {
					margin-top: 8px;
					font-size: 14px;
					color: #71717a;
				}

				.form {
					margin-top: 32px;
					display: flex;
					flex-direction: column;
					gap: 20px;
				}

				.row {
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: 16px;
				}

				.field {
					display: flex;
					flex-direction: column;
				}

				.label {
					font-size: 14px;
					font-weight: 500;
					margin-bottom: 6px;
				}

				.input {
					width: 100%;
					border: 1px solid #d4d4d8;
					border-radius: 10px;
					padding: 10px 12px;
					font-size: 14px;
					outline: none;
					transition:
						border-color 0.15s ease,
						box-shadow 0.15s ease;
					background: white;
				}

				.input:focus {
					border-color: #18181b;
					box-shadow: 0 0 0 3px #e4e4e7;
				}

				.error {
					margin-top: 6px;
					font-size: 13px;
					color: #dc2626;
				}

				.error-box {
					border: 1px solid #fecaca;
					background: #fef2f2;
					color: #b91c1c;
					padding: 12px;
					border-radius: 10px;
					font-size: 14px;
				}

				.submit {
					width: 100%;
					border: none;
					border-radius: 10px;
					background: #18181b;
					color: white;
					padding: 12px 16px;
					font-size: 14px;
					font-weight: 500;
					cursor: pointer;
					transition:
						background 0.15s ease,
						transform 0.05s ease;
				}

				.submit:hover {
					background: #27272a;
				}

				.submit:active {
					transform: scale(0.99);
				}

				@media (max-width: 640px) {
					.card {
						padding: 24px;
					}

					.row {
						grid-template-columns: 1fr;
					}
				}
			</style>
		</head>

		<body>
			<div class="page">
				<div class="card">
					<div>
						<h1 class="title">
							Initial admin setup
						</h1>

						<p class="subtitle">
							Create the first administrator account for this instance.
						</p>
					</div>

					<form action="/setup" method="post" class="form">
						<div class="field">
							<label class="label">
								Email
							</label>

							<input
								name="email"
								type="email"
								placeholder="john@example.com"
								value={ data.Email }
								autocomplete="off"
								class="input"
							/>

							if msg, ok := data.Errors["email"]; ok {
								<p class="error">{ msg }</p>
							}
						</div>

						<div class="row">
							<div class="field">
								<label class="label">
									First name
								</label>

								<input
									name="first_name"
									type="text"
									placeholder="John"
									value={ data.FirstName }
									class="input"
								/>

								if msg, ok := data.Errors["first_name"]; ok {
									<p class="error">{ msg }</p>
								}
							</div>

							<div class="field">
								<label class="label">
									Last name
								</label>

								<input
									name="last_name"
									type="text"
									placeholder="Doe"
									value={ data.LastName }
									class="input"
								/>

								if msg, ok := data.Errors["last_name"]; ok {
									<p class="error">{ msg }</p>
								}
							</div>
						</div>

						<div class="field">
							<label class="label">
								Password
							</label>

							<input
								name="password"
								type="password"
								placeholder="••••••••"
								class="input"
							/>

							if msg, ok := data.Errors["password"]; ok {
								<p class="error">{ msg }</p>
							}
						</div>

						<div class="field">
							<label class="label">
								Confirm password
							</label>

							<input
								name="password_confirm"
								type="password"
								placeholder="••••••••"
								class="input"
							/>

							if msg, ok := data.Errors["password_confirm"]; ok {
								<p class="error">{ msg }</p>
							}
						</div>

						if msg, ok := data.Errors["general"]; ok {
							<div class="error-box">
								{ msg }
							</div>
						}

						<div>
							<button type="submit" class="submit">
								Create administrator
							</button>
						</div>
					</form>
				</div>
			</div>
		</body>
	</html>
}