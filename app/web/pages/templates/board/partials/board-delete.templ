package partials

import "fmt"

templ BoardDelete(projectID, boardID, _csrf string) {
	<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#boardDeleteModal">
		Delete board
	</button>
	<div class="modal fade" id="boardDeleteModal" tabindex="-1" aria-labelledby="boardDeleteModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="boardDeleteModalLabel">Delete board</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p>Deleting board will delete all tasks related to it</p>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button
						type="submit"
						class="btn btn-danger"
						hx-delete={ fmt.Sprintf("/hx/projects/%s/board/%s", projectID, boardID) }
						hx-headers={ fmt.Sprintf("{\"X-CSRF-TOKEN\": \"%s\"}", _csrf) }
					>
						Delete
					</button>
				</div>
			</div>
		</div>
	</div>
}
