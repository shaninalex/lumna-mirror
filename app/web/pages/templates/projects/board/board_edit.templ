package board

import "gitlab.com/shaninalex/lumna/app/web/pages/templates"
import "fmt"

templ BoardEdit(page BoardPageData) {
	@templates.Dashboard(page.BasePage) {
		<a href={ templ.SafeURL(fmt.Sprintf("/projects/%s/board/%s", page.Board.ProjectID.String(), page.Board.ID.String())) }>
			<i class="bi bi-chevron-left"></i> Back
		</a>
		<div>Board { page.Board.Title } edit page</div>
	}
}
