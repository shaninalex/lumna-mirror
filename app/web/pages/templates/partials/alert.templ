package partials

import "fmt"

type AlertType string

var (
	AlertTypePrimary   AlertType = "primary"
	AlertTypeSecondary AlertType = "secondary"
	AlertTypeSuccess   AlertType = "success"
	AlertTypeDanger    AlertType = "danger"
	AlertTypeWarning   AlertType = "warning"
	AlertTypeInfo      AlertType = "info"
	AlertTypeLight     AlertType = "light"
	AlertTypeDark      AlertType = "dark"
)

func alertCssClass(alertType *AlertType) string {
	if alertType != nil {
		return fmt.Sprintf("alert alert-%s", string(*alertType))
	}
	return "alert"
}

templ Alert(msg string, alertType *AlertType) {
	<div class={ alertCssClass(alertType) } role="alert">
		{ msg }
	</div>
}
