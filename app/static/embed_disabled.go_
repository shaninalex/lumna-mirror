//go:build !embed
// +build !embed

package static

import (
	"embed"
	"io/fs"
	"log"
)

var ResourcesFS embed.FS

// GetStaticFS embedded static files
func GetStaticFS() fs.FS {
	sub, err := fs.Sub(ResourcesFS, "frontend/browser")
	if err != nil {
		log.Printf("warning: failed to load embedded static files: %v", err)
		return nil
	}
	return sub
}

