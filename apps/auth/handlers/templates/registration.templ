package templates

templ RegistrationTemplate(csrfInput string, err error) {
    <!doctype html>
    <html lang="en">
    <head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="ie=edge">
        <title>Login page</title>
    </head>
    <body>
        <form method="post" action="/auth/registration">
            @templ.Raw(csrfInput)

            <div>
                <label for="email">Email</label>
                <input autocomplete="email" id="email" name="email" type="email" placeholder="Enter your email" required />
            </div>

            <div>
                <label for="password">Password</label>
                <input id="password" name="password" type="password" placeholder="***" required />
            </div>

            <div>
                <button type="submit">Registration</button>
            </div>

            if err != nil {
                <div style="color: red">{ err.Error() }</div>
            }

            <hr>

            <a href={ templ.URL("/auth/login") }>Login</a>
        </form>
    </body>
    </html>
}